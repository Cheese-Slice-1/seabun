; let=.
; comments work!! otherwise it'd give an error

;! doc comment
;! this function does something
let foo = fun: a num, b dot {
	show "so...\n".
	show "a is ", a as str, "\n". ; "(num/unum value) as str" works like C's itoa
	showln: "b is ", b as str!. ; automatic new line; builtin *function*!!
}.

let bar = fun: a num, b dot -> str {
	if a > b {
		give a as str. ; give = return
	} else if b > a {
		give b as str.
	} else {
		give (a as dot + b) as str.
	}
}.

let fibb = fun: nth num -> num {
	if nth <= 1 do give clip: nth, 0!.
	
	give (fibb: nth - 1! + fibb: nth - 2!).
}.

; function that takes a function and applies it twice
let dotwice = fun: f fun: num!, x num {
	f: x.
	f: x!.
}.

; record called user
;! doc comment
def person rec:
	name str,
	surnames [2]str,
	age num,
	likes [10]str,
	hates [10]str.

; named tuple called rgb
def rgb {{num, num, num}}.

; enum called wind_direction
; fields are num by default
def wind |north, south, east, west|.

; a "main" (entry point) block is also an expression, so it requires a dot
main {
	let first num = 10.
	let second dot = 1d5. ; d stands for dot

	foo: first, second!.

	let baz str = bar: first, second!.

	let fibb5 = fibb: 5!.

	; named parameters are optional, you can use positional
	; ones if you want to
	let johndoe person = rec:
		name = "John",
		surnames = ["Doe", "Smith"],
		age = 20,
		likes = ["icecream", "chocolate", "programming"], ; the rest of fields are empty strings
		hates = ["bugs", "brainrot", ""]. ; same here

	; instantiation of tuple types
	let grassygreen rgb = {{197, 255, 0}}.
	let puregreen = rgb{{0x00, 0xFF, 0x00}}.

	; a closure argument! here "!" is also the same as "!"
	dotwice:
		fun: a num! { showln: a!. }!.
}.
